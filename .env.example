# Copy to .env.local (gitignored) and fill in. Also set these in Vercel.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Error monitoring (Better Stack or Sentry; both accept the Sentry SDK).
# Optional: without it monitoring is a no-op. Only active in production builds.
VITE_SENTRY_DSN=

# Source map upload to Better Stack (build-time only; set in Vercel, not in .env.local).
# Without these, builds skip the upload and emit no source maps.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_URL=
SENTRY_AUTH_TOKEN=
